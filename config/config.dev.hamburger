# 主配置文件
{
  # 子配置入口
  pxy_backend_file: "config/backend.hamburger",
  pxy_frontend_file: "config/frontend.hamburger",
  domain_map: "config/services.hamburger",

  # 插件系统
  plugin: {
    enabled: false,
    root: "plugins",
    plugins: []
  },

  # 核心代理配置
  proxy: {
    flush_interval: 0,
    buf_size: 65536,
    transport: "fasthttp",
    proxy_mode: "fasthttp",
    net_io: "nbio",
    max_conns_per_host: 100,
    idle_conn_timeout: 60
  },

  # 错误页配置
  error_config: {
    error_mode: "html",
    enable_page_cache: true,
    error_page: {
      "403": "static/403.html",
      "404": "static/404.html",
      "429": "static/429.html",
      "500": "static/500.html",
      "502": "static/502.html"
    }
  },

  # 网关监听服务
  servers: [
    {
      name: "http-server",
      host: @ZeroHost,
      port: 88,
      use_http2: true,
      protocol: "http",
      enabled: true,
      max_request_body: 50 * 1<<20,
      domains: [
        {
          domains: ["renj.io", "service.renj.io", "dev.renj.io", "blog.renj.io", "me.renj.io", "gallery.renj.io", "jjapp.renj.io", "pkg.renj.io"],
          auto_redirect: true
        }
      ]
    },
  ],

  # 中间件
  middleware: {
    cors: {
      enabled: true,
      header: ["Content-Type", "Origin", "Authorization", "access-token", "Token"]
    },
    trace: {
      enabled: true,
      trace_id: "X-Gateway-Trace-Id"
    },
    secure_header: true,
    gzip: {
      enabled: true,
      level: 6,
      types: [
        "text/html",
        "text/css",
        "text/javascript",
        "text/plain",
        "text/xml",
        "application/javascript",
        "application/xml",
        "application/json",
        "font/ttf",
        "font/woff",
        "font/woff2",
        "font/otf"
      ],
      threshold: 2048
    }
  },

  # 功能模块
  features: {
    flow_control: {
      enabled: true,
      global_limit: {
        requests: 10000,
        window: "60s",
        unit: "s"
      },
      rules: [
        {
          name: "api-limit",
          enabled: true,
          priority: 1,
          match_type: "host",
          match_value: "renj.io",
          header_key: "",
          limits: [
            {
              requests: 1000,
              window: "10s",
              unit: "s"
            },
            {
              requests: 5000,
              window: "10min",
              unit: "min"
            }
          ],
          action: "block",
          description: "API服务限流"
        }
      ],
      recording: {
        enabled: false,
        record_blocked: true,
        record_allowed: false,
        storage_type: "file",
        retention_period: "30d"
      }
    },
    websocket: {
      enabled: true
    },
    proxy_cache: {
      enabled: true,
      cache_size: 2048,
      cache_ttl: 3600
    }
  },

  # 数据源
  database: {
    mongo: {
      url: "mongodb://localhost:27017",
      database: "ApolloMongo",
      timeout: 10
    },
    influx: {
      enabled: false,
      url: "http://localhost:8086",
      token: "",
      org: "sandwich",
      bucket: "sandwich",
      password: ""
    }
  },

  # 安全
  security: {
    strict_mode: true,
    allow_ips: [],
    deny_ips: [],
    rate_limit: 1000
  },

  # 代理头
  proxy_header: {
    trace_id: "X-Gateway-Trace-Id",
    frontend_host_header: "X-Proxy-Internal-Host",
    backend_header: "X-Proxy-Internal-Local",
    proxy_app: "X-Proxy-Backend",
    forward_host_header: "X-Forward-Host"
  },

  # 日志
  log: {
    log_level: "debug",
    log_file: "",
    color: true
  },

  module: null,

  # API 服务配置
  api_server_config: {
    enabled: true,
    host: @Localhost,
    port: 8888,
    http2: {
      enabled: true,
      insecure: true
    },
    bblot: {
      enabled: true,
      file: "data/hamburger-api.db"
    }
  },

  # 状态统计
  stat: {
    db_file: "data/stat.db",
    use_db: false,
    compatible: true,
    enabled: false,
    enable_stat: false,
    sync_duration: 720,
    save_duration: 3600,
    save_file: "data/stat.json",
    geo_file: "data/geo.json",
    domain_file: "data/domain.json",
    geo_db: "",
    sequence: {
      enabled: true,
      interval: 60,
      retention_days: 30,
      flush_interval: 5,
      cleanup_interval: 3600
    }
  },

  # 自定义响应头
  custom_header: {
    Proxy-Copyright: @Copyright,
    Proxy-Server: @AppName
  },

  # 定时任务
  syncer: {
    job_sync_domains: 60,
    job_sync_domain_ports: 60
  },

  debug: false,
  pprof: {
    enable: false,
    port: 8889
  },
  max_cores: 4,
  pxy_backend: {},
  pxy_frontend: {},

  # 实验模块
  exp_config: {
    traversal: {
      enabled: true,
      listen_host: "0.0.0.0",
      listen_port: 19090,
      # 控制通道协议：
      #   "tcp"     : 仅 TCP（默认）
      #   "kcp"     : 仅 KCP
      #   "tcp+kcp" : 同时启用 TCP 与 KCP，便于兼容老客户端并让新客户端走 KCP
      protocol: "tcp",
      kcp: {
        # KCP 控制通道心跳（秒）。<=0 关闭心跳。
        heartbeat_interval: 20,
        # KCP 控制通道心跳超时（秒）。超过该时间未收到任何控制消息将断开连接。
        heartbeat_timeout: 60
      },
      auth_key: "change-me"
    },
    webdav: {
      enabled: false,
      host: "0.0.0.0",
      port: 1900,
      path_prefix: "/",
      read_only: false,
      read_timeout: 30,
      write_timeout: 30,
      users: [
        {
          username: "alice",
          password: "alice-password",
          root_dir: "/root",
          read_only: false
        },
        {
          username: "bob",
          password: "bob-password",
          root_dir: "/home",
          read_only: true
        }
      ]
    },
    trojan_server: ""
  }
}
